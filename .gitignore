node_modules/
tests/.shots/
# the vendored helpers (audiveris, the transcription venv, yt-dlp, ffmpeg) live in tools/ and are not source; the home-PC worker (G10b-1) is
/tools/*
!/tools/home-worker/
# ... but its settings hold the person's token
/tools/home-worker/worker.config.json
/tools/home-worker/*.local.json
# a tools/ folder deeper down (tests/*/tools, ...) is ignored as before; the ones below that are source say so
*/**/tools/
data/*.json
.DS_Store

# Secrets. The API key lives here in development and must never be committed.
.env
.env.*
!.env.example

# G0 benchmark outputs and caches (tests/bench/README.md). Committed corpus,
# suites, baselines and golden files are not under these paths.
tests/bench/out/
# the root "tools/" rule above is for the vendored helpers; the benchmark's own tools are source
!tests/bench/tools/
# ... and so are the ScoreGraph tests' (fixture generators, the A/B comparison, G01)
!tests/scoregraph/tools/
# ... and the engraving tests' (fixture and corpus generators, the L1 benchmark, page checks, G04); their run output is not
!tests/engrave/tools/
tests/engrave/out/
# ... and the playability tests' (the legacy-arranger baseline script, G05)
!tests/playability/tools/
# ... and the difficulty model's (dataset builder, trainer/evaluator, the committed dataset and evaluation, G06)
!difficulty/tools/
# ... and the SongGraph analyzer's (hymn-SATB ground-truth eval, corpus sanity/perf check, G07)
!songgraph/tools/
# ... and the Arrangement Planner's (corpus sanity/coverage/perf check, G07B)
!arrangement/tools/
# ... and the ScoreGraph's notation checker (rests and rhythm of a recording, G09 section 12)
!scoregraph/tools/
# ... and the G8a realizer's comparative evaluation harness (vs. all 3 legacy engines, G08).
# Two concurrent implementations landed in this worktree mid-session (docs/GOALS/
# G08_ARRANGEMENT_REALIZATION.md §14); the Lead kept this one (realize/) after independent
# review - see §14's "Lead decision" note.
!realize/tools/
# ... and the recording conversion v2's trainer and its committed evaluation (rec/, G10a-1)
!rec/tools/
tests/realize/out/
tests/bench/.cache/
__pycache__/
# Local experiments; holds copyrighted audio and PDFs that must never be committed.
tmp/
