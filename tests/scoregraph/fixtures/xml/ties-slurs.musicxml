      <note><pitch><step>C</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><notations><slur type="start" number="1" placement="above"/></notations></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><notations><slur type="start" number="2" placement="below"/></notations></note>
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><notations><slur type="stop" number="2"/></notations></note>
      <note><pitch><step>G</step><octave>5</octave></pitch><duration>2</duration><tie type="start"/><voice>1</voice><type>quarter</type><notations><tied type="start"/><slur type="stop" number="1"/><slur type="start" number="1"/></notations></note>
    </measure>
    <measure number="2">
