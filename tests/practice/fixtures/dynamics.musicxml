<?xml version="1.0" encoding="UTF-8"?>
<!-- G11a-1 fixture, written by hand for the tests of PPP (no source music): how loud, in 4/4 with quarters of 1, one staff.
     Bar 1: p, then an accented and a marcato quarter. Bar 2: a crescendo to the f of bar 3. Bar 3: f, an sf written on one note.
     Bar 4: a diminuendo from beat 1 to beat 3, where an mp is printed that also carries <sound dynamics="50"/>. -->
<score-partwise version="4.0">
  <work><work-title>Dynamics</work-title></work>
  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
