<?xml version="1.0" encoding="UTF-8"?>
<!-- G11a-4 fixture, written by hand for the parity harness of PPP (no source music): the damper at the arrival of a D.S. Five bars of 4/4, one staff. Bar 2 holds the segno and presses the damper (line pedal, no stop in bars 1-4); bar 3 holds the Fine; the D.S. al Fine is at the end of bar 4; the pedal comes up in bar 5, in the middle, which is never played (the piece ends at the Fine). Written order: 1 2 3 4 | 5 (not reached). As an engraver reads it: 1 2 3 4 | 2 3 (Fine). Without the rule the way back keeps the damper down (CC64 127 only, once) and every note of bars 2-4 is held to the written pedal end (bar 5), so the strings of bar 4 ring on into bar 2 of the way back. -->
<score-partwise version="4.0">
  <work><work-title>The damper at the arrival of a D.S.</work-title></work>
  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
  <part id="P1">
    <measure number="1"><attributes><divisions>1</divisions><key><fifths>0</fifths></key><time><beats>4</beats><beat-type>4</beat-type></time><clef><sign>G</sign><line>2</line></clef></attributes><note><pitch><step>C</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type>whole</type></note></measure>
    <measure number="2"><direction placement="above"><direction-type><segno/></direction-type></direction><direction placement="below"><direction-type><pedal type="start" line="yes"/></direction-type></direction><note><pitch><step>D</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type>whole</type></note></measure>
    <measure number="3"><note><pitch><step>E</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type>whole</type></note><direction placement="above"><direction-type><words>Fine</words></direction-type><sound fine="yes"/></direction></measure>
    <measure number="4"><note><pitch><step>F</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type>whole</type></note><direction placement="above"><direction-type><words>D.S. al Fine</words></direction-type><sound dalsegno="segno1"/></direction></measure>
    <measure number="5"><note><pitch><step>G</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type></note><direction placement="below"><direction-type><pedal type="stop" line="yes"/></direction-type></direction><note><pitch><step>A</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type></note><barline location="right"><bar-style>light-heavy</bar-style></barline></measure>
  </part>
</score-partwise>
