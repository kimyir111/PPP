# PPP local service configuration. This file is gitignored and is read only by
# omr-service.js — never by the browser. Copy to .env and fill in what you need.

# ---- the AI coach ----
# PPP prefers Claude when a key is present, then Ollama, then plans by itself.
# Nothing here is required: with none of it set the coach still works, PPP just
# writes the session and the panel says so.

# Claude, over the Anthropic API. Paid per request.
ANTHROPIC_API_KEY=sk-ant-...
# PPP_COACH_MODEL=claude-opus-5

# Ollama, on this machine. Free. The model must already be pulled.
# PPP_OLLAMA_URL=http://127.0.0.1:11434
# PPP_OLLAMA_MODEL=qwen3:8b
# PPP_OLLAMA_TIMEOUT_MS=180000

# Pin one provider instead of letting PPP choose: anthropic | ollama
# PPP_COACH_PROVIDER=auto
